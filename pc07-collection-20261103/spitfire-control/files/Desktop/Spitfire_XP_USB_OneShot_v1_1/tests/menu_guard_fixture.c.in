 p=gdi_fixture();gdi_font_change=1;check("Native fontcache changed during measure blocks",!inspect_heading(&p,&h)&&!gdi_resource_count);
 p=gdi_fixture();gdi_object_change=1;check("Native HFONT LOGFONT changed during measure blocks",!inspect_heading(&p,&h)&&!gdi_resource_count);
 printf("%d native menu checks passed\n",passed);return 0;
}
