static void word(DWORD a,DWORD v){memcpy(memory+a,&v,4);}
static void shortword(DWORD a,short v){memcpy(memory+a,&v,2);}
static void list(DWORD handle,DWORD base,const DWORD*entries,unsigned count){unsigned i;word(handle,base);word(base+4,0xb00bdeed);word(base+0x10,4);word(base+0x14,count);for(i=0;i<count;i++)word(base+0x18+i*4,entries[i]);}
