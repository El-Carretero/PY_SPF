static Panel fixture(int help,int field){
 Panel p;DWORD top[]={0x14000,0x15000,0x16000},entries[]={0x18000,0x18100,0x18200,0x18300};unsigned i,n=help?1:4;DWORD item;const char*labels[]={"Empower Setup","Active Faults","Timing and High Voltage","Temperature Control"};DWORD callbacks[]={0x4072c9,0x4072ea,0x40730b,0x40734d};
 memset(memory,0,sizeof(memory));memset(&p,0,sizeof(p));process_allowed=main_allowed=1;unreadable=0;focus_process=(HANDLE)0x444;closed_outer=close_count=0;
 p.mode=help?"about":"temperature";p.menu_id=help?9:4;p.item_id=help?10:8;p.callback=help?0x40732c:0x40734d;
 word(0x110ec,0x12000);word(0x12000,0x12100);word(0x12100,0xeb15);word(0x1214c,0x13000);list(0x13000,0x13100,top,3);
 for(i=0;i<3;i++){DWORD b=top[i]+0x100;word(top[i],b);word(b,0xeb16);word(b+0x28,i==0?2:i==1?4:9);word(b+0x9c,0x12000);word(b+0x98,(help?i==2:i==1)?0x20000:0);word(b+0xb0,0x17000);}
 list(0x17000,0x17100,entries,n);
 for(i=0;i<n;i++){DWORD b=entries[i]+0x40;word(entries[i],b);word(b,0xeb18);word(b+0x28,help?10:5+i);word(b+0x9c,help?0x16000:0x15000);word(b+0xa0,0x12000);word(b+0x3c,help?0x40732c:callbacks[i]);}
 word(0x20000,0x20100);word(0x20100,loaded_cvi_base+0x9f664);word(0x20128,0x21000);word(0x20120,field?17:16);word(0x2012c,n);word(0x20144,1);word(0x2014c,n);word(0x20150,1);
 word(0x21000,0x21100);word(0x21158,0x55);word(0x2112c,loaded_cvi_base+0x9f664);word(0x21150,0x20000);
 fake_client=(RECT){0,0,field?164:189,(field?17:16)*(int)n};fake_origin=(POINT){267,131};fake_window=(RECT){264,128,267+fake_client.right+3,131+fake_client.bottom+3};
 shortword(0x2010c,0);shortword(0x2010e,0);shortword(0x20110,fake_client.bottom);shortword(0x20112,fake_client.right);
 memory[0x2015e]=4;memcpy(memory+0x2015f,help?"Help":"View",4);item=0x20166;
 for(i=0;i<n;i++){const char*t=help?"About":labels[i];unsigned len=strlen(t),payload=(len+4)&~3u;native_addresses[i]=item;shortword(item+0x1a,payload);memory[item+0x1e]=(!help&&i==0)?0:1;memory[item+0x28]=len;memcpy(memory+item+0x29,t,len);item+=0x28+payload;}
 return p;
}
