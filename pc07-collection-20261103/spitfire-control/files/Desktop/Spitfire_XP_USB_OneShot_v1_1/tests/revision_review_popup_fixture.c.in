#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <wchar.h>
#include <wctype.h>

typedef uint32_t DWORD;
typedef int BOOL;
typedef intptr_t LPARAM;
typedef uintptr_t HWND;
typedef wchar_t WCHAR;
typedef struct {int32_t left,top,right,bottom;} RECT;
typedef struct {int32_t x,y;} POINT;
typedef struct {int ignored;} Panel;
#define TRUE 1
#define FALSE 0
#define CALLBACK
#define ZeroMemory(p,n) memset((p),0,(n))

/* SNAPSHOT_TYPE */

static MenuSnapshot menu_snapshot,menu_candidate;
static int popup_matches,popup_seen_count,menu_frozen,menu_serial;
static HWND popup_hwnd;
static const char *menu_reason="",*menu_detail="";
static DWORD original_pid=77;
static Panel panel;
static const Panel *action_panel_spec=&panel;
struct Window {HWND hwnd;DWORD pid;int visible,valid;const WCHAR *cls;MenuSnapshot model;};
static struct Window windows[4];
static unsigned window_count,observations,checks;
static int fail_observation;

static struct Window *window(HWND h) {
 unsigned i;for(i=0;i<window_count;i++)if(windows[i].hwnd==h)return windows+i;
 assert(!"unknown mock HWND");return NULL;
}
static void GetWindowThreadProcessId(HWND h,DWORD *pid) {*pid=window(h)->pid;}
static int IsWindowVisible(HWND h) {return window(h)->visible;}
static int GetClassNameW(HWND h,WCHAR *out,int n) {wcsncpy(out,window(h)->cls,(size_t)n);out[n-1]=0;return (int)wcslen(out);}
static int _wcsicmp(const WCHAR *a,const WCHAR *b) {while(*a&&towlower(*a)==towlower(*b)){a++;b++;}return (int)towlower(*a)-(int)towlower(*b);}
static int inspect_popup(HWND h,const Panel *p,MenuSnapshot *out) {assert(p==&panel);*out=window(h)->model;return window(h)->valid;}
static int menu_observation(const MenuSnapshot *m,int ok,const char *phase) {(void)m;(void)ok;(void)phase;observations++;menu_serial++;return !fail_observation;}
static int EnumWindows(BOOL (*cb)(HWND,LPARAM),LPARAM param) {unsigned i;for(i=0;i<window_count;i++)if(!cb(windows[i].hwnd,param))break;return 1;}

/* ACTUAL_FUNCTIONS */

static void reset(void) {
 ZeroMemory(windows,sizeof(windows));ZeroMemory(&menu_snapshot,sizeof(menu_snapshot));
 ZeroMemory(&menu_candidate,sizeof(menu_candidate));window_count=1;observations=0;fail_observation=0;
 popup_matches=popup_seen_count=menu_frozen=menu_serial=0;popup_hwnd=0;
 menu_reason=menu_detail="";
 windows[0].hwnd=100;windows[0].pid=77;windows[0].visible=windows[0].valid=1;
 windows[0].cls=L"CVIRTLVMenuWnd4194304";
 windows[0].model.hwnd=100;windows[0].model.public_menu_id=4;
 windows[0].model.item_count=4;windows[0].model.selected_index=3;
 windows[0].model.row_height=17;windows[0].model.first_visible=1;windows[0].model.last_visible=4;
 windows[0].model.window_rect=(RECT){264,128,434,202};
 windows[0].model.client_rect=(RECT){0,0,164,68};
 windows[0].model.hit=(POINT){349,190};
 windows[0].model.public_item_ids[3]=8;windows[0].model.callbacks[3]=0x40734d;
 windows[0].model.enabled[3]=1;strcpy(windows[0].model.labels[3],"Temperature Control");
}
static void passed(const char *name) {checks++;printf("PASS %s\n",name);}
static void freeze(void) {assert(observed_popup(1));assert(menu_frozen&&popup_hwnd==100);}

int main(void) {
 reset();freeze();assert(observed_popup(0));passed("unchanged bound metadata permits recheck");
 reset();assert(!observed_popup(0));passed("input recheck cannot run before freezing");
 reset();windows[0].pid=78;assert(!observed_popup(1));passed("foreign process popup is not accepted");
 reset();windows[0].visible=0;assert(!observed_popup(1));passed("hidden popup is not accepted");
 reset();windows[0].cls=L"OtherClass";assert(!observed_popup(1));passed("unrecognized popup class is not accepted");
 reset();windows[0].valid=0;assert(!observed_popup(1));passed("failed identity inspector cannot freeze a popup");
 reset();fail_observation=1;assert(!observed_popup(1));assert(!strcmp(menu_reason,"evidence_write_failed"));passed("missing selected-layout evidence blocks freeze success");
 reset();windows[1]=windows[0];windows[1].hwnd=101;windows[1].model.hwnd=101;window_count=2;
 assert(!observed_popup(1));passed("two valid original popups are ambiguous");
 reset();windows[1]=windows[0];windows[1].hwnd=101;windows[1].model.hwnd=101;windows[1].valid=0;window_count=2;
 assert(!observed_popup(1));passed("extra original popup blocks even when only one validates");
 reset();freeze();window_count=0;assert(!observed_popup(0));passed("disappearing popup blocks input");
 reset();freeze();windows[0].hwnd=windows[0].model.hwnd=101;assert(!observed_popup(0));passed("replaced popup HWND blocks input");
 reset();freeze();windows[0].model.window_rect.right++;assert(!observed_popup(0));passed("changed popup bounds block input");
 reset();freeze();windows[0].model.hit.y++;assert(!observed_popup(0));passed("changed hit target blocks input");
 reset();freeze();windows[0].model.public_menu_id=2;assert(!observed_popup(0));passed("switched public menu identity blocks input");
 reset();freeze();windows[0].model.callbacks[3]=0x400001;assert(!observed_popup(0));passed("changed callback blocks input");
 reset();freeze();windows[0].model.labels[3][0]='X';assert(!observed_popup(0));passed("changed item label blocks input");
 reset();freeze();windows[0].model.enabled[3]=0;assert(!observed_popup(0));passed("newly disabled target blocks input");
 reset();freeze();windows[0].model.row_height=16;assert(!observed_popup(0));passed("changed native row metric blocks input");
 reset();freeze();windows[0].model.checked[3]=1;assert(!observed_popup(0));passed("changed checked state blocks input");
 printf("%u independent popup envelope checks passed\n",checks);return 0;
}
