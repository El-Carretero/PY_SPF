#include <stdint.h>
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <wchar.h>
#include <string.h>
typedef uint32_t DWORD; typedef wchar_t WCHAR;typedef void* HWND;typedef intptr_t LPARAM;typedef int BOOL;
typedef struct {long left,top,right,bottom;} RECT;
typedef struct {unsigned cbSize;DWORD dwTime;} LASTINPUTINFO;
#define TRUE 1
#define CALLBACK
#define ZeroMemory(a,n) memset(a,0,n)
#define _wcsicmp wcscmp
static DWORD original_pid=100, fake_pid=100, fake_tick=100;
static HWND main_hwnd=(HWND)1,popup_hwnd=(HWND)3,guard_owned=(HWND)2;
static int guard_phase,guard_extra_windows, fake_visible=1, held,cancelled_flag,input_ok=1;
static const char*guard_window_reason;static const WCHAR*fake_class=L"CVIRTLVDChild4194304";
static RECT fake_rect={0,0,100,100};
static DWORD GetWindowThreadProcessId(HWND h,DWORD*p){(void)h;if(p)*p=fake_pid;return 5;}
static int IsWindowVisible(HWND h){(void)h;return fake_visible;}
static int GetClassNameW(HWND h,WCHAR*s,int n){(void)h;wcsncpy(s,fake_class,n);s[n-1]=0;return wcslen(s);}
static int GetWindowRect(HWND h,RECT*r){(void)h;*r=fake_rect;return 1;}
static int cancelled(void){return cancelled_flag;}
static int any_held_input(void){return held;}
static int GetLastInputInfo(LASTINPUTINFO*p){p->dwTime=fake_tick;return input_ok;}
static int count;
static void check(int got,int expected,const char*name){if(got!=expected){fprintf(stderr,"FAIL %s got%d expected%d\n",name,got,expected);exit(1);}count++;}

@NATIVE_FUNCTIONS@
static void window_case(HWND h,int phase,int expected,const char*reason){guard_phase=phase;guard_extra_windows=0;guard_window_reason=NULL;context_window_cb(h,0);check(guard_extra_windows,expected,"window count");if(reason&&(!guard_window_reason||strcmp(guard_window_reason,reason)))exit(1);}
int main(void){
check(focus_policy(1,0,0,0,0,0),1,"none");check(focus_policy(0,0,0,0,0,0),0,"invalidnone");check(focus_policy(1,12,0,0,0,0),0,"missingnodeactive");
check(focus_policy(1,0,100,3,3,1),1,"rememberedring");check(focus_policy(1,12,100,3,3,1),1,"activering");check(focus_policy(1,0,100,3,7,1),0,"rememberednumeric");check(focus_policy(1,0,100,1,3,1),0,"unsupportedkind");check(focus_policy(1,0,100,3,3,2),0,"ambiguousmapping");check(focus_policy(1,0,100,0,0,0),0,"unknownnode");
window_case((HWND)1,0,0,NULL);window_case((HWND)2,0,1,"initial_auxiliary_open");window_case((HWND)2,2,0,NULL);window_case((HWND)4,2,1,"initial_auxiliary_open");
fake_class=L"CVIRTLVMenuWnd4194304";window_case((HWND)3,0,1,"original_popup_open");window_case((HWND)3,1,0,NULL);window_case((HWND)4,1,1,"original_popup_open");
fake_class=L"CVIRTLVFrame4194304";fake_rect.right=fake_rect.bottom=-10;window_case((HWND)4,0,0,NULL);fake_rect.right=100;window_case((HWND)4,0,1,"initial_auxiliary_open");
fake_pid=101;window_case((HWND)4,0,0,NULL);fake_pid=100;fake_visible=0;window_case((HWND)4,0,0,NULL);
check(input_tick_matches(100),1,"sameinput");check(input_tick_matches(99),0,"changedinput");held=1;check(input_tick_matches(100),0,"heldinput");held=0;cancelled_flag=1;check(input_tick_matches(100),0,"cancelledinput");cancelled_flag=0;input_ok=0;check(input_tick_matches(100),0,"unreadableinput");
printf("%d UI policy/context checks passed\n",count);return 0;}
