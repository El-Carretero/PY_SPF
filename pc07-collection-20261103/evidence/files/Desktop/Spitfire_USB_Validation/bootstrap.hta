<html><head><HTA:APPLICATION APPLICATIONNAME="SPF USB bootstrap" /><script language="JScript">function boot(){try{var text="<html><head><title>Isolated XP validation transport</title><HTA:APPLICATION APPLICATIONNAME=\"SPF USB VM validation\" /><script language=\"JScript\">\nvar B=\"http://10.19.70.13:18979/\",D=\"C:\\\\SPF_USB_VALIDATION\",f,s,last=\"\",busy=false;\nfunction req(method,url,data){var x=new ActiveXObject(\"MSXML2.XMLHTTP\");x.open(method,url,false);x.setRequestHeader(\"Cache-Control\",\"no-cache\");x.send(typeof(data)==\"undefined\"?null:data);if(x.status!=200)throw new Error(\"HTTP \"+x.status+\" \"+url);return x;}\nfunction mkdir(p){if(!f.FolderExists(p)){var parent=f.GetParentFolderName(p);if(parent&&!f.FolderExists(parent))mkdir(parent);f.CreateFolder(p);}}\nfunction download(name,path){mkdir(f.GetParentFolderName(path));var x=req(\"GET\",B+name+\"?t=\"+new Date().getTime()),a=new ActiveXObject(\"ADODB.Stream\");a.Type=1;a.Open();a.Write(x.responseBody);a.SaveToFile(path,2);a.Close();}\nfunction upload(path,name){if(!f.FileExists(path))return;var a=new ActiveXObject(\"ADODB.Stream\");a.Type=1;a.Open();a.LoadFromFile(path);req(\"POST\",B+\"upload/\"+name,a.Read());a.Close();}\nfunction textfile(path,t){var x=f.CreateTextFile(path,true,false);x.Write(t);x.Close();}\nfunction uploadtree(path,name){if(!f.FolderExists(path))return;var en=new Enumerator(f.GetFolder(path).Files);for(;!en.atEnd();en.moveNext())upload(en.item().Path,name+\"--\"+en.item().Name);en=new Enumerator(f.GetFolder(path).SubFolders);for(;!en.atEnd();en.moveNext())uploadtree(en.item().Path,name+\"--\"+en.item().Name);}\nfunction say(t){document.getElementById(\"status\").innerText=new Date().toUTCString()+\" \"+t;}\nfunction poll(){if(busy)return;busy=true;try{var raw=req(\"GET\",B+\"control.json?t=\"+new Date().getTime()).responseText,c=eval(\"(\"+raw+\")\");if(!c.id||c.id==last){busy=false;return;}last=c.id;var rc=0;for(var i=0;i<c.ops.length;i++){var o=c.ops[i];if(o.op==\"download\")download(o.name,o.path);else if(o.op==\"run\")rc=s.Run(o.command,o.style==null?0:o.style,o.wait!==false);else if(o.op==\"upload\")upload(o.path,c.id+\"--\"+o.name);else if(o.op==\"uploadtree\")uploadtree(o.path,c.id+\"--\"+o.name);else if(o.op==\"write\")textfile(o.path,o.text);else if(o.op==\"quit\"){textfile(D+\"\\\\\"+c.id+\"-complete.txt\",\"quit\");upload(D+\"\\\\\"+c.id+\"-complete.txt\",c.id+\"-complete.txt\");window.close();return;}else throw new Error(\"Unknown op\");}textfile(D+\"\\\\\"+c.id+\"-complete.txt\",\"exit=\"+rc);upload(D+\"\\\\\"+c.id+\"-complete.txt\",c.id+\"-complete.txt\");say(c.id+\" complete exit=\"+rc);}catch(e){say(\"ERROR \"+(e.description||e.message));try{textfile(D+\"\\\\\"+last+\"-error.txt\",e.description||e.message);upload(D+\"\\\\\"+last+\"-error.txt\",last+\"-error.txt\");}catch(z){}}busy=false;}\nfunction boot(){try{window.resizeTo(620,180);f=new ActiveXObject(\"Scripting.FileSystemObject\");s=new ActiveXObject(\"WScript.Shell\");mkdir(D);textfile(D+\"\\\\ready.txt\",\"isolated p07 XP transport ready\");upload(D+\"\\\\ready.txt\",\"ready.txt\");window.setInterval(poll,1200);poll();}catch(e){say(\"BOOT ERROR \"+(e.description||e.message));}}\nwindow.onload=boot;<\/script></head><body><p>Isolated p07 XP package validation transport</p><pre id=\"status\"></pre></body></html>";var f=new ActiveXObject("Scripting.FileSystemObject"),s=new ActiveXObject("WScript.Shell"),d="C:\\SPF_USB_VALIDATION";if(!f.FolderExists(d))f.CreateFolder(d);var p=d+"\\controller.hta",o=f.CreateTextFile(p,true,false);o.Write(text);o.Close();s.Run('mshta.exe "'+p+'"',1,false);window.close();}catch(e){document.body.innerText=e.description||e.message;}}window.onload=boot;</script></head><body>Starting local validation transport.</body></html>