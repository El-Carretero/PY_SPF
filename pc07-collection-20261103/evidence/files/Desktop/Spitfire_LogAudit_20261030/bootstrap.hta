<html>
<head>
<title>Spitfire XP Runtime File Audit</title>
<HTA:APPLICATION ID="audit" APPLICATIONNAME="SPF XP audit" BORDER="dialog" CAPTION="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" SYSMENU="yes" SCROLL="yes" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<style type="text/css">body{font:14px Tahoma;background:#edf1f5;color:#18212b;margin:18px}h2{font-size:20px}pre{white-space:pre-wrap;font:12px Consolas,monospace;background:white;padding:12px;border:1px solid #aab7c4}button{padding:7px;margin-right:8px}</style>
<script language="JScript">
var BASE="http://10.19.70.13:18977/";
var DIR="C:\\SPF_AUDIT_20261030";
var CFG="C:\\config.sp";
var fso=null,sh=null,target="",cwd="",lastSeq="",busy=false,ready=false,started=false;
var history=[];
function element(id){return document.getElementById(id);}
function now(){return new Date().toUTCString();}
function errorText(e){return e.description||e.message||String(e);}
function request(method,url,body){var x=new ActiveXObject("MSXML2.XMLHTTP");x.open(method,url,false);try{x.setRequestHeader("Cache-Control","no-cache");}catch(ignore){}if(method=="POST")x.setRequestHeader("Content-Type","application/octet-stream");if(body===null||typeof body=="undefined")x.send();else x.send(body);if(x.status!=200)throw new Error("HTTP "+x.status+" "+url);return x;}
function sendText(name,text){var a=new ActiveXObject("ADODB.Stream");a.Type=2;a.Charset="utf-8";a.Open();a.WriteText(text);a.Position=0;a.Type=1;request("POST",BASE+"upload/"+encodeURIComponent(name),a.Read());a.Close();}
function status(text){history.push(now()+" | "+text);if(history.length>120)history.shift();element("status").innerText=history.join("\r\n");try{sendText("status.txt",history.join("\r\n")+"\r\n");}catch(e){element("connection").innerText="Status upload failed: "+errorText(e);}}
function localText(path,text){var file=fso.CreateTextFile(path,true,false);file.Write(text);file.Close();}
function readText(path){var file=fso.OpenTextFile(path,1,false);var text=file.ReadAll();file.Close();return text;}
function download(name){var x=request("GET",BASE+name+"?t="+new Date().getTime(),null);var a=new ActiveXObject("ADODB.Stream");a.Type=1;a.Open();a.Write(x.responseBody);a.SaveToFile(DIR+"\\"+name,2);a.Close();status("Downloaded "+name);}
function upload(path,name,optional){if(!fso.FileExists(path)){if(optional){status("Absent (allowed): "+path);return false;}throw new Error("Missing file: "+path);}var a=new ActiveXObject("ADODB.Stream");a.Type=1;a.Open();a.LoadFromFile(path);request("POST",BASE+"upload/"+encodeURIComponent(name),a.Read());a.Close();status("Uploaded "+name);return true;}
function findExeIn(folder,depth){if(!fso.FolderExists(folder))return "";var exact=folder+"\\SPITFIRE.EXE";if(fso.FileExists(exact))return exact;if(depth<=0)return "";var list=new Enumerator(fso.GetFolder(folder).SubFolders);for(;!list.atEnd();list.moveNext()){var found=findExeIn(list.item().Path,depth-1);if(found)return found;}return "";}
function tryDesktop(folder){if(!folder||!fso.FolderExists(folder))return false;var items=new Enumerator(fso.GetFolder(folder).Files);for(;!items.atEnd();items.moveNext()){var file=items.item();var name=String(file.Name).toLowerCase();if(name.indexOf("spitfire")<0||fso.GetExtensionName(name)!="lnk")continue;try{var link=sh.CreateShortcut(file.Path);var candidate=sh.ExpandEnvironmentStrings(link.TargetPath);if(String(fso.GetFileName(candidate)).toLowerCase()=="spitfire.exe"&&fso.FileExists(candidate)){target=candidate;cwd=sh.ExpandEnvironmentStrings(link.WorkingDirectory);if(!cwd||!fso.FolderExists(cwd))cwd=fso.GetParentFolderName(target);status("Original found via shortcut "+file.Path);return true;}}catch(ignored){}}return false;}
function discover(){var folders=[];try{folders.push(sh.SpecialFolders("Desktop"));}catch(ignore1){}try{folders.push(sh.SpecialFolders("AllUsersDesktop"));}catch(ignore2){}for(var i=0;i<folders.length;i++)if(tryDesktop(folders[i]))return;var programFiles=sh.ExpandEnvironmentStrings("%ProgramFiles%");if(!programFiles||programFiles.indexOf("%")>=0)programFiles="C:\\Program Files";var fixed=programFiles+"\\Spitfire";target=findExeIn(fixed,2);if(!target&&fso.FolderExists(programFiles)){var sub=new Enumerator(fso.GetFolder(programFiles).SubFolders);for(;!sub.atEnd();sub.moveNext()){var folder=sub.item();if(String(folder.Name).toLowerCase().indexOf("spitfire")>=0){target=findExeIn(folder.Path,2);if(target)break;}}}if(!target)throw new Error("Original SPITFIRE.EXE not found via Desktop shortcut or Program Files Spitfire folders");cwd=fso.GetParentFolderName(target);status("Original found in Spitfire Program Files directory");}
function osInfo(){var result="";try{var svc=GetObject("winmgmts:{impersonationLevel=impersonate}!\\\\.\\root\\cimv2");var list=new Enumerator(svc.ExecQuery("SELECT Caption,Version,CSDVersion FROM Win32_OperatingSystem"));for(;!list.atEnd();list.moveNext()){var os=list.item();result+=os.Caption+" | "+os.Version+" | "+os.CSDVersion+"\r\n";}}catch(e){result="OS query failed: "+errorText(e);}return result;}
function preserveConfig(){var marker=DIR+"\\config-state.txt";var backup=DIR+"\\config.sp.original.bin";if(!fso.FileExists(marker)){if(fso.FileExists(CFG)){fso.CopyFile(CFG,backup,true);localText(marker,"present");status("Backed up original C:\\config.sp byte-for-byte");}else{localText(marker,"absent");status("Original C:\\config.sp was absent");}}else if(readText(marker)=="present"&&!fso.FileExists(backup))throw new Error("Config state says present but exact backup is missing");localText(CFG,"[Spitfire]\r\nmaxLevel=3146\r\n");status("Temporary Programmer config installed");}
function recordFeed(){try{var svc=GetObject("winmgmts:{impersonationLevel=impersonate}!\\\\.\\root\\cimv2");var processes=new Enumerator(svc.ExecQuery("SELECT ProcessId,ExecutablePath FROM Win32_Process WHERE Name='udp-feed.exe'"));var text="Loopback-only helper launched for600 seconds\r\n";for(;!processes.atEnd();processes.moveNext()){var p=processes.item();text+="PID="+p.ProcessId+" path="+p.ExecutablePath+"\r\n";}localText(DIR+"\\feed-process.txt",text);upload(DIR+"\\feed-process.txt","feed-process.txt",false);}catch(e){status("Feed PID query unavailable: "+errorText(e));}}
function startAudit(){if(!ready)throw new Error("Bootstrap/selftest not ready");if(started){status("Start ignored: original already launched by this audit");return;}preserveConfig();sh.CurrentDirectory=DIR;var feed='cmd.exe /d /c ""'+DIR+'\\udp-feed.exe" 600 > "'+DIR+'\\feed-output.txt" 2>&1"';sh.Run(feed,0,false);status("Started hidden loopback-only UDP feed for600 seconds");recordFeed();sh.CurrentDirectory=cwd;var command='"'+DIR+'\\filetrace.exe" "'+DIR+'\\spitfire.jsonl" "'+target+'"';sh.Run(command,1,false);started=true;status("Original launched under tracer; CWD="+cwd);status("Use original UI manually; original process is never force-closed by this HTA");}
function collect(name){upload(DIR+"\\spitfire.jsonl",name||"spitfire-live.jsonl",true);upload(cwd+"\\datalog.csv","datalog.csv",true);upload(DIR+"\\feed-output.txt","feed-output.txt",true);}
function restore(){var marker=DIR+"\\config-state.txt";var backup=DIR+"\\config.sp.original.bin";if(fso.FileExists(marker)){var state=readText(marker);if(state=="present"){if(!fso.FileExists(backup))throw new Error("Cannot restore config: backup missing");fso.CopyFile(backup,CFG,true);status("Restored original C:\\config.sp exactly");}else if(state=="absent"){if(fso.FileExists(CFG))fso.DeleteFile(CFG,true);status("Restored config absence");}else throw new Error("Unknown config backup state");}else status("No config backup state; no config change to restore");collect("spitfire-final.jsonl");status("Restore complete. UDP feed expires at its bounded600-second limit; original was not closed");}
function action(name){try{if(name=="start")startAudit();else if(name=="collect")collect("spitfire-live.jsonl");else if(name=="restore")restore();else if(name!="wait")status("Unknown action ignored: "+name);}catch(e){status("ACTION ERROR "+name+": "+errorText(e));}}
function poll(){if(busy||!ready)return;busy=true;try{var text=request("GET",BASE+"control.txt?t="+new Date().getTime(),null).responseText;var pieces=String(text).replace(/^\s+|\s+$/g,"").split("|");if(pieces.length>=2&&pieces[0]!=lastSeq){lastSeq=pieces[0];element("connection").innerText="Control sequence "+lastSeq+": "+pieces[1];action(pieces[1].toLowerCase());}}catch(e){element("connection").innerText="Control polling: "+errorText(e);}busy=false;}
function bootstrap(){try{window.resizeTo(850,620);}catch(ignore){}try{fso=new ActiveXObject("Scripting.FileSystemObject");sh=new ActiveXObject("WScript.Shell");if(!fso.FolderExists(DIR))fso.CreateFolder(DIR);status("Bootstrap starting; local directory="+DIR);download("filetrace.exe");download("trace-selftest.exe");download("udp-feed.exe");discover();var meta="time="+now()+"\r\noriginal="+target+"\r\nworking_directory="+cwd+"\r\nuser="+sh.ExpandEnvironmentStrings("%USERNAME%")+"\r\ncomputer="+sh.ExpandEnvironmentStrings("%COMPUTERNAME%")+"\r\nOS="+osInfo();localText(DIR+"\\metadata.txt",meta);upload(DIR+"\\metadata.txt","metadata.txt",false);upload(target,"original-SPITFIRE.EXE",false);sh.CurrentDirectory=DIR;var result=sh.Run('"'+DIR+'\\filetrace.exe" "'+DIR+'\\selftest.jsonl" "'+DIR+'\\trace-selftest.exe"',0,true);upload(DIR+"\\selftest.jsonl","selftest.jsonl",false);var trace=readText(DIR+"\\selftest.jsonl");if(result!=0||trace.indexOf('"all_hooks_installed":true')<0||trace.indexOf('"tracing_error":false')<0||trace.indexOf('"api":"NtWriteFile"')<0)throw new Error("Tracer selftest failed or incomplete; exit="+result);ready=true;status("READY: tracer selftest passed; awaiting seq|start from host");window.setInterval(poll,1500);poll();}catch(e){status("BOOTSTRAP ERROR: "+errorText(e));}}
window.onload=bootstrap;
</script>
</head>
<body>
<h2>Spitfire XP runtime file audit</h2>
<p>Original EXE remains unchanged. Host commands: <b>start / collect / restore</b>.</p>
<div id="connection">Connecting to isolated audit host...</div>
<p><button onclick="action('collect')">Collect trace</button><button onclick="action('restore')">Restore config</button></p>
<pre id="status">Initializing...</pre>
</body>
</html>
