<html><head><title>SPF audit cleanup</title><HTA:APPLICATION APPLICATIONNAME="SPF audit cleanup" /><script language="JScript">
window.onload=function(){try{var fs=new ActiveXObject("Scripting.FileSystemObject"),sh=new ActiveXObject("WScript.Shell"),root="C:\\SPF_AUDIT_20261030";var svc=GetObject("winmgmts:{impersonationLevel=impersonate}!\\\\.\\root\\cimv2");var p=new Enumerator(svc.ExecQuery("SELECT Name,ProcessId FROM Win32_Process WHERE Name='Spitfire.exe' OR Name='filetrace.exe' OR Name='udp-feed.exe'"));var list=[];for(;!p.atEnd();p.moveNext())list.push(String(p.item().Name)+":"+p.item().ProcessId);var csv="C:\\Program Files\\Spectra-Physics\\Spitfire\\datalog.csv",moved=false;if(!list.length&&fs.FileExists(csv)&&fs.GetFile(csv).Size==871&&!fs.FileExists(root+"\\datalog-test.csv")){fs.MoveFile(csv,root+"\\datalog-test.csv");moved=true;}var text='{"original_and_trace_helpers_remaining":'+list.length+',"config_sp_exists":'+fs.FileExists("C:\\config.sp")+',"synthetic_csv_moved_to_audit_folder":'+moved+'}';var x=new ActiveXObject("MSXML2.XMLHTTP");x.open("POST","http://10.19.70.13:18977/upload/cleanup-guest.json",false);x.send(text);if(x.status!=200)throw new Error("Cleanup status upload failed");document.getElementById("out").innerText=text;if(!list.length){sh.Run('cmd.exe /d /c "taskkill /im mshta.exe & taskkill /im cmd.exe"',0,false);}}catch(e){document.getElementById("out").innerText=e.description||e.message;}}
</script></head><body><pre id="out">Restoring task state and closing audit windows...</pre></body></html>