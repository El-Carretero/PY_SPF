<html><head><title>SPF runtime diagnostic</title><HTA:APPLICATION APPLICATIONNAME="SPF runtime diagnostic" /><script language="JScript">
window.onload=function(){var text="";try{var svc=GetObject("winmgmts:{impersonationLevel=impersonate}!\\\\.\\root\\cimv2");var items=new Enumerator(svc.ExecQuery("SELECT Name,ProcessId,ParentProcessId,ThreadCount,KernelModeTime,UserModeTime,CommandLine FROM Win32_Process WHERE Name='Spitfire.exe' OR Name='filetrace.exe' OR Name='udp-feed.exe'"));for(;!items.atEnd();items.moveNext()){var p=items.item();text+=p.Name+" PID="+p.ProcessId+" parent="+p.ParentProcessId+" threads="+p.ThreadCount+" kernel="+p.KernelModeTime+" user="+p.UserModeTime+" command="+p.CommandLine+"\r\n";}var sh=new ActiveXObject("WScript.Shell");var e=sh.Exec("cmd.exe /d /c netstat -ano");text+="\r\n"+e.StdOut.ReadAll();var x=new ActiveXObject("MSXML2.XMLHTTP");x.open("POST","http://10.19.70.13:18977/upload/diagnostic.txt",false);x.send(text);document.getElementById("out").innerText=text;}catch(e){document.getElementById("out").innerText=text+"\r\nERROR:"+(e.description||e.message);}}
</script></head><body><pre id="out">Inspecting XP process and network state...</pre></body></html>