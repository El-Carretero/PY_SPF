<html><head><title>Spitfire capture bootstrap</title><HTA:APPLICATION APPLICATIONNAME="SPF original bootstrap" /><script language="JScript">
function boot(){try{var localText="<html><head><title>Spitfire original capture controller</title><HTA:APPLICATION APPLICATIONNAME=\"SPF original capture 20261101\" />\n<script language=\"JScript\">\nvar B=\"http://10.19.70.13:18979/\",D=\"C:\\\\SPF_ORIGINAL_CAPTURE_20261101\",f,s,last=\"\",busy=false,lines=[];\nfunction req(method,url,data){var x=new ActiveXObject(\"MSXML2.XMLHTTP\");x.open(method,url,false);x.setRequestHeader(\"Cache-Control\",\"no-cache\");x.send(typeof(data)==\"undefined\"?null:data);if(x.status!=200)throw new Error(\"HTTP \"+x.status+\" \"+url);return x;}\nfunction download(name){var x=req(\"GET\",B+name+\"?t=\"+new Date().getTime()),a=new ActiveXObject(\"ADODB.Stream\");a.Type=1;a.Open();a.Write(x.responseBody);a.SaveToFile(D+\"\\\\\"+name,2);a.Close();}\nfunction upload(path,name){if(!f.FileExists(path))return;var a=new ActiveXObject(\"ADODB.Stream\");a.Type=1;a.Open();a.LoadFromFile(path);req(\"POST\",B+\"upload/\"+name,a.Read());a.Close();}\nfunction textfile(path,t){var x=f.CreateTextFile(path,true,false);x.Write(t);x.Close();}\nfunction say(t){lines.push(new Date().toUTCString()+\" | \"+t);document.getElementById(\"status\").innerText=lines.join(\"\\r\\n\");}\nfunction poll(){if(busy)return;busy=true;try{var c=req(\"GET\",B+\"control.txt?t=\"+new Date().getTime()).responseText.replace(/^\\s+|\\s+$/g,\"\");var m=/^(\\d+)\\|(inventory|launch|about|temperature|timing|faults|setup|exit|regensvc|close|optout_on|update|quit_agent)$/.exec(c);if(!m||m[1]==last){busy=false;return;}last=m[1];var name=m[1]+\"-\"+m[2],rc=0;\nif(m[2]==\"quit_agent\"){textfile(D+\"\\\\\"+name+\".txt\",\"agent stopped\");upload(D+\"\\\\\"+name+\".txt\",name+\".txt\");window.close();return;}\nif(m[2]==\"update\"){download(\"guest_driver.exe\");say(\"Driver updated for verified actions\");}else{var out=D+\"\\\\\"+name;rc=s.Run('\"'+D+'\\\\guest_driver.exe\" '+m[2]+' \"'+out+'\" \"'+D+'\\\\host-isolation-proof.txt\"',0,true);if(f.FolderExists(out)){var fs=new Enumerator(f.GetFolder(out).Files);for(;!fs.atEnd();fs.moveNext()){var file=fs.item();upload(file.Path,name+\"-\"+file.Name);}}}\nsay(name+\" finished, exit=\"+rc);textfile(D+\"\\\\\"+name+\"-complete.txt\",lines.join(\"\\r\\n\"));upload(D+\"\\\\\"+name+\"-complete.txt\",name+\"-complete.txt\");}catch(e){say(\"ERROR: \"+(e.description||e.message));}busy=false;}\nfunction boot(){try{window.resizeTo(800,450);f=new ActiveXObject(\"Scripting.FileSystemObject\");s=new ActiveXObject(\"WScript.Shell\");if(f.FolderExists(D))throw new Error(\"Capture directory already exists; no overwrite\");f.CreateFolder(D);download(\"guest_driver.exe\");download(\"host-isolation-proof.txt\");upload(\"C:\\\\Program Files\\\\Spectra-Physics\\\\Spitfire\\\\Spitfire.exe\",\"original-SPITFIRE.EXE\");textfile(D+\"\\\\controller-ready.txt\",\"Guest controller ready; user authorized Empower Opt-out ON only; other changing controls forbidden\");upload(D+\"\\\\controller-ready.txt\",\"controller-ready.txt\");say(\"Ready: original program capture; host action queue, native guest automation\");window.setInterval(poll,1200);poll();}catch(e){say(\"BOOT ERROR: \"+(e.description||e.message));}}\nwindow.onload=boot;<\/script></head><body><h2>Spitfire original capture</h2><p>Isolated simulator only. Empower Opt-out ON is the only allowed setting action.</p><pre id=\"status\"></pre></body></html>\n";var f=new ActiveXObject("Scripting.FileSystemObject"),s=new ActiveXObject("WScript.Shell"),d="C:\\SPF_ORIGINAL_BOOT_20261101";if(!f.FolderExists(d))f.CreateFolder(d);var p=d+"\\controller.hta",o=f.CreateTextFile(p,true,false);o.Write(localText);o.Close();s.Run('mshta.exe "'+p+'"',1,false);window.close();}catch(e){document.getElementById("status").innerText=e.description||e.message;}}window.onload=boot;</script></head><body><pre id="status">Starting guest-local capture controller.</pre></body></html>