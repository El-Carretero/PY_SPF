{
  "theme": "base",
  "securityLevel": "strict",
  "htmlLabels": false,
  "fontFamily": "\"URW Gothic\", \"Latin Modern Math\"",
  "themeVariables": {
    "fontFamily": "\"URW Gothic\", \"Latin Modern Math\"",
    "fontSize": "18px",
    "primaryColor": "#FFFFFF",
