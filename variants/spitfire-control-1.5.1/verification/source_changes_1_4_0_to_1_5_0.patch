+import queue
+import threading
+import time
+import unittest
+
+from spitfire_control.serial_service import (
+    RawSerialSession,
+    SerialServiceError,
+    SerialSettings,
+    encode_transmission,
+    parse_hex_bytes,
+)
+
+
+class FakeSerial:
+    def __init__(self, **kwargs):
+        self.kwargs = kwargs
+        self.is_open = False
+        self.dtr = False
+        self.rts = False
+        self.written = bytearray()
+        self._incoming = bytearray()
+        self._lock = threading.Lock()
+
+    @property
+    def in_waiting(self):
+        with self._lock:
+            return len(self._incoming)
+
+    def feed(self, data: bytes):
+        with self._lock:
+            self._incoming.extend(data)
+
+    def read(self, count: int) -> bytes:
+        deadline = time.monotonic() + 0.01
+        while self.is_open and time.monotonic() < deadline:
+            with self._lock:
+                if self._incoming:
+                    result = bytes(self._incoming[:count])
+                    del self._incoming[:count]
+                    return result
+            time.sleep(0.001)
+        return b""
+
+    def write(self, data: bytes) -> int:
+        if not self.is_open:
+            raise OSError("closed")
+        self.written.extend(data)
+        return len(data)
+
+    def open(self):
+        self.is_open = True
+
+    def close(self):
+        self.is_open = False
+
+
+class SerialCodecTests(unittest.TestCase):
+    def test_hex_formats(self):
+        self.assertEqual(parse_hex_bytes("53 54 4f 50"), b"STOP")
