+MODULE_FAULT_BITS = {
+    7: (1066, 0x4000), 8: (1066, 0x8000), 9: (1066, 0x0800),
+    11: (1066, 0x2000), 16: (1066, 0x1000),
+    20: (1088, 0x10), 21: (1088, 0x04),
+    10: (1089, 0x01), 24: (1089, 0x02), 25: (1089, 0x08),
