+        except ValueError as exc:
+            raise SerialServiceError("Port 설정의 숫자 값을 확인하십시오.") from exc
+
+    def toggle_connection(self) -> None:
+        if self.session.connected:
+            self.session.close()
+            self._set_connected(False)
+            return
