+            if send_guard is None:
+                perform()
+            else:
+                send_guard(perform)
+            return result
+        except TransportError:
+            raise
+        except (ProtocolError, ValueError, KeyError) as exc:
+            raise TransportError(f"Simulator rejected command: {exc}") from exc
