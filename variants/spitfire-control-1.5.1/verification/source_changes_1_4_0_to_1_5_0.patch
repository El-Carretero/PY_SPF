+        self.assertEqual(encode_transmission("*IDN?", "ASCII", "CRLF"), b"*IDN?\r\n")
+        self.assertEqual(encode_transmission("00 FF", "HEX", "NONE"), b"\x00\xff")
+        with self.assertRaises(SerialServiceError):
