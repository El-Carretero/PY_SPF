{
  "schema_version": 1,
  "id": "pump_absent",
  "name": "외부 펌프 상실",
  "description": "외부 펌프 존재 신호를 잃는 추상 시나리오. 광학 에너지 감소와 동일시하지 않음.",
  "duration_ms": 100,
  "policy": {},
  "initial_signals": {},
  "events": [
    {
      "at_ms": 0,
      "type": "arm"
    },
    {
      "at_ms": 0,
      "type": "trigger"
    },
    {
      "at_ms": 50,
      "type": "signals",
      "values": {
        "pump_present": false
      }
    }
  ],
  "assertions": [
    {
      "at_ms": 50,
      "path": "latched_faults",
      "op": "contains",
      "expected": "pump_missing"
    },
    {
      "at_ms": 100,
      "path": "inhibited",
      "op": "eq",
      "expected": true
    }
  ]
}
