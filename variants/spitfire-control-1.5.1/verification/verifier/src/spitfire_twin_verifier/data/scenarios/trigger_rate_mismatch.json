{
  "schema_version": 1,
  "id": "trigger_rate_mismatch",
  "name": "펌프 트리거 주파수 불일치",
  "description": "예상 10 Hz에 대해 20 Hz 트리거 입력. 전기 신호 계측 결과가 아님.",
  "duration_ms": 100,
  "policy": {},
  "initial_signals": {},
  "events": [
    {
      "at_ms": 0,
      "type": "arm"
    },
    {
      "at_ms": 0,
      "type": "trigger"
    },
    {
      "at_ms": 50,
      "type": "trigger"
    }
  ],
  "assertions": [
    {
      "at_ms": 50,
      "path": "latched_faults",
      "op": "contains",
      "expected": "trigger_rate_mismatch"
    },
    {
      "at_ms": 100,
      "path": "inhibited",
      "op": "eq",
      "expected": true
    }
  ]
}
